<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.matheusmedrado.summon</string>
    <key>BundleProgram</key><string>Contents/MacOS/Summon</string>
    <key>AssociatedBundleIdentifiers</key><array><string>com.matheusmedrado.summon</string></array>
    <key>RunAtLoad</key><true/>
    <!-- restart after a crash, but stay closed after Quit -->
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ProcessType</key><string>Interactive</string>
    <key>EnvironmentVariables</key><dict><key>SUMMON_AGENT</key><string>1</string></dict>
</dict>
</plist>
